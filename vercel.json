{
  "rewrites": [
    {
      "source": "/p/:jeton",
      "destination": "/api/pointage-public?j=:jeton"
    },
    {
      "source": "/parents",
      "destination": "/pour-les-parents.html"
    },
    {
      "source": "/parents/",
      "destination": "/pour-les-parents.html"
    },
    {
      "source": "/demo-parent",
      "destination": "/index.html"
    },
    {
      "source": "/backoffice",
      "destination": "/index.html"
    },
    {
      "source": "/backoffice/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "timat.app"
        }
      ],
      "destination": "https://www.timat.app/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/calcul-mensualisation-assistante-maternelle.html",
      "destination": "/blog/calcul-mensualisation-assistante-maternelle",
      "permanent": true
    },
    {
      "source": "/conges-payes-assistante-maternelle.html",
      "destination": "/blog/conges-payes-assistante-maternelle",
      "permanent": true
    },
    {
      "source": "/cout-reel-assistante-maternelle-reste-a-charge.html",
      "destination": "/blog/cout-reel-assistante-maternelle-reste-a-charge",
      "permanent": true
    },
    {
      "source": "/indemnite-entretien-assistante-maternelle-2026.html",
      "destination": "/blog/indemnite-entretien-assistante-maternelle-2026",
      "permanent": true
    },
    {
      "source": "/pajemploi-declaration-assistante-maternelle.html",
      "destination": "/blog/pajemploi-declaration-assistante-maternelle",
      "permanent": true
    },
    {
      "source": "/salaire-assistante-maternelle-net-brut.html",
      "destination": "/blog/salaire-assistante-maternelle-net-brut",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/timat-vs-pandi-panda.html",
      "destination": "/blog/quel-logiciel-assistante-maternelle",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/publier-article",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-essais",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    },
    {
      "source": "/demo-parent",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
